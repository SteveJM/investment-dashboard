# Postgres connection
DATABASE_URL=postgres://investment_dashboard:devpassword@localhost:5432/investment_dashboard

# REST API
API_PORT=4000

# MCP server (Streamable HTTP transport)
MCP_PORT=4001

# Shared bearer token required on:
#  - every /api/* request via `Authorization: Bearer <token>`
#  - every MCP request via the same header
# Set a strong random value before exposing this service beyond localhost
# (e.g. before pointing a scheduled Claude task at it over the network).
API_KEY=devkey

# Data providers: set to "mock" for offline dev/demo with no network calls;
# unset (or "yahoo"/"gemini") for the real implementation (see src/providers/).
PRICE_PROVIDER=mock
NEWS_PROVIDER=mock

# Powers the ticker page's "Generate News Summary" button
# (src/providers/summaries.ts). SUMMARY_PROVIDER=mock needs no API key,
# same as above. For real summaries, set SUMMARY_PROVIDER=gemini (or leave
# it unset - that's the default) and provide a Gemini API key from
# https://aistudio.google.com/apikey.
SUMMARY_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS: comma-separated list of origins the frontend is served from
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
