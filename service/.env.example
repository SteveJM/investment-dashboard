# Postgres connection
DATABASE_URL=postgres://investment_dashboard:devpassword@localhost:5432/investment_dashboard

# REST API
API_PORT=4000

# MCP server (Streamable HTTP transport)
MCP_PORT=4001

# Shared bearer token required on:
#  - every /api/* request via `Authorization: Bearer <token>`
#  - every MCP request via the same header
# Set a strong random value before exposing this service beyond localhost
# (e.g. before pointing a scheduled Claude task at it over the network).
API_KEY=devkey

# Data providers: "mock" is the only implementation shipped today. Swap in a
# real provider later (see src/providers/) without changing callers.
PRICE_PROVIDER=mock
NEWS_PROVIDER=mock

# CORS: comma-separated list of origins the frontend is served from
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
