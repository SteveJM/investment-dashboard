# Copy to .env and adjust before running `docker compose up`.
# All variables here have working defaults baked into docker-compose.yml -
# you only need this file to override them (in particular, set a real
# API_KEY before exposing the service beyond your own machine).

POSTGRES_PASSWORD=devpassword
API_KEY=devkey
# yahoo = real (free, delayed, unofficial) quotes via yahoo-finance2 - the default.
# mock = deterministic fake GBP quotes, no network calls - handy for offline dev/demo.
PRICE_PROVIDER=yahoo
# yahoo = real headlines (with real article links) via yahoo-finance2's search endpoint - the default.
# mock = deterministic fake placeholder headlines, no network calls - handy for offline dev/demo.
NEWS_PROVIDER=yahoo
# Comma-separated - whichever accounts you actually want to tag watch-list items against.
# Validated at startup (must be non-empty) and enforced on every account-setting request.
ACCOUNTS=ISA,Taxable,Pension
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
